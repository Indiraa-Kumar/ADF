								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_DB",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "asdfg"
								}
							},
							"firstRowOnly": false
						}
					},
