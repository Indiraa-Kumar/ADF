						"name": "IngestAllTables",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "ReadTheListOfTables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('ReadTheListOfTables').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "ExecuteIngestionPL",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_INGESTION",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"table_name": {
												"value": "@item().table_name",
												"type": "Expression"
											}
										}
									}
								},
								{
									"name": "store table success",
									"type": "AppendVariable",
									"dependsOn": [
										{
											"activity": "ExecuteIngestionPL",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"variableName": "table_status",
										"value": {
											"value": "@item().table_name - Success",
											"type": "Expression"
										}
									}
								},
								{
									"name": "store table failure",
									"type": "AppendVariable",
									"dependsOn": [
										{
											"activity": "ExecuteIngestionPL",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"variableName": "table_status",
										"value": {
											"value": "@item().table_name - failure",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
