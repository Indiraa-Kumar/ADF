{
	"name": "PL_FOR_EACH_DEMO",
	"properties": {
		"activities": [
			{
				"name": "IngestAllTables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ReadTheListOfTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('ReadTheListOfTables').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "ExecuteIngestionPL",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_INGESTION",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "store table success",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "ExecuteIngestionPL",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": {
									"value": "@item().table_name - Success",
									"type": "Expression"
								}
							}
						},
						{
							"name": "store table failure",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "ExecuteIngestionPL",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": {
									"value": "@item().table_name - failure",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "ReadTheListOfTables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT table_name from metadata.table_list",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_DB",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"table_name": "asdfg"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "send consolidated email",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "IngestAllTables",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_EMAIL_DEMO_MULTIPLE",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"email": {
							"value": "@pipeline().globalParameters.email_recipients",
							"type": "Expression"
						},
						"table_status": {
							"value": "@variables('table_status')",
							"type": "Expression"
						}
					}
				}
			}
		],
		"variables": {
			"table_status": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-29T08:59:22Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}